PORT=5000
MONGODB_URI=mongodb+srv://username:password@example.mongodb.net/database
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=30m
CORS_ORIGINS=http://localhost:5173
JSON_BODY_LIMIT=2mb
FORM_BODY_LIMIT=512kb
# Desktop SQL Server .bak conversion (Windows/SQL Server or LocalDB)
# Optional. When omitted on Windows, the newest accessible installed SQL Server instance is selected automatically.
# DESKTOP_IMPORT_SQL_SERVER=.\SQLEXPRESS
DESKTOP_IMPORT_SQLCMD=sqlcmd
DESKTOP_IMPORT_SQL_TRUST_CERTIFICATE=true
DESKTOP_IMPORT_MAX_BYTES=1073741824
DESKTOP_IMPORT_MAX_FILES=4
DESKTOP_IMPORT_SQL_TIMEOUT_MS=900000
DESKTOP_IMPORT_JOB_TTL_MS=86400000
